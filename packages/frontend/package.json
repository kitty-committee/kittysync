{
    "name": "@kittysync/frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check:type": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "check:test": "vitest run"
    },
    "devDependencies": {
        "@humanspeak/svelte-markdown": "^2.1.3",
        "@kittysync/common": "workspace:*",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@vitest/browser-playwright": "^4.1.8",
        "playwright": "^1.64.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^4.1.8",
        "vitest-browser-svelte": "^2.1.1",
        "zod": "^4.6.7"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "dependencies": {
        "@hocuspocus/provider": "^4.8.0",
        "@tiptap/core": "^3.32.2",
        "@tiptap/extension-collaboration": "^3.32.2",
        "@tiptap/markdown": "^3.32.2",
        "@tiptap/pm": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "yjs": "^13.6.33"
    }
